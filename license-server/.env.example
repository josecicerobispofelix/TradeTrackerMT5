# ── Banco de dados ────────────────────────────────────────────────────────────
# Railway injeta DATABASE_URL automaticamente para PostgreSQL.
# Para rodar local, deixe comentado (usa SQLite licenses.db).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=troque-por-uma-senha-forte

# ── Webhook Hotmart ───────────────────────────────────────────────────────────
# Token secreto que você define no painel Hotmart ao cadastrar o webhook.
# A URL que você coloca na Hotmart fica assim:
#   https://<seu-servidor-railway>/webhook/hotmart?hottok=SEU_TOKEN_AQUI
HOTMART_HOTTOK=seu-token-secreto-aqui

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
# Recomendado: Gmail com "Senha de app" (2FA ativado na conta Google).
# Gere em: Conta Google → Segurança → Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-aqui
SMTP_FROM_NAME=TradeTracker MT5
